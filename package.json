{
  "name": "dsh-plugin-composer-predictions",
  "version": "1.3.0",
  "description": "Composer predictions for the DeepSeek Harness: predict up to three next chat messages after an assistant reply, show the selected one as in-editor ghost text, switch with ArrowUp/ArrowDown, and insert with Tab.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boshihaihai/dsh-plugin-composer-predictions.git"
  },
  "homepage": "https://github.com/boshihaihai/dsh-plugin-composer-predictions#readme",
  "bugs": {
    "url": "https://github.com/boshihaihai/dsh-plugin-composer-predictions/issues"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/client.test.js test/server.test.js",
    "test:browser": "node test/browser-smoke.cjs",
    "check": "node --check client.js && node --check predict-server.js",
    "pack:plugin": "npm pack --pack-destination dist"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": ["dsh", "deepseek-harness", "plugin", "composer", "prediction", "ghost-text"],
  "exports": {
    ".": "./predict-server.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "predict-server.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
